{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/fa/",
      "permanent": true
    },
    {
      "source": "/fa/insights/ai-orthodontics/",
      "destination": "/fa/insights/ai-orthodontics-dentistry/",
      "permanent": true
    },
    {
      "source": "/en/insights/ai-orthodontics/",
      "destination": "/en/insights/ai-orthodontics-dentistry/",
      "permanent": true
    },
    {
      "source": "/fa/insights/ai-dental-implant-dentistry/",
      "destination": "/fa/insights/ai-dental-implants/",
      "permanent": true
    },
    {
      "source": "/en/insights/ai-dental-implant-dentistry/",
      "destination": "/en/insights/ai-dental-implants/",
      "permanent": true
    },
    {
      "source": "/tr/insights/implant-dis-hekimliginde-yapay-zeka/",
      "destination": "/tr/insights/dis-implantlarinda-yapay-zeka/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
